# AIS AssetTrack server settings - copy to settings.env next to the server (same folder as AssetTrack_Server.exe or
# E:\AssetTrack\server) and fill in what you need. Lines starting with # are ignored. Restart the server after changes.
# Developed by DT

# ---- Network name the HHTs use (ask IT for a DNS name pointing to this server) ----
PUBLIC_NAME=assettrack

# ---- Database ----
# Pilot (default): SQLite file next to the server - nothing to set.
# Production (SQL Server; IT creates the empty database, the server creates its tables on first start):
# PALLET_DB_URL=mssql+pyodbc://assettrack_user:PASSWORD@SQLSERVER\INSTANCE/AssetTrack?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Windows login of the service account instead of user/password:
# PALLET_DB_URL=mssql+pyodbc://@SQLSERVER/AssetTrack?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# ---- Security ----
# Leave unset: the server makes a random secret.key next to the database on first start. Set only when several
# servers must share one secret (load balanced).
# PALLET_JWT_SECRET=
# Oldest HHT app allowed to connect (older apps are told to update). Raise after every APK roll-out.
PALLET_MIN_CLIENT=1.6.0
# 1 = physical transactions only from the HHT (recommended). 0 = also from the web (training / testing only).
PALLET_HHT_ONLY=1
# BENCH (default) = dispatch pick lists come only from the Dispatch Planning Bench; AssetTrack creates only Empty Pallet Returns.
# APP = AssetTrack can also release part / pallet pick lists itself (blanket orders, WMS stock, PDI pages become visible).
PALLET_PICKLIST_SOURCE=BENCH

# ---- Customer reminder emails (overdue pallets) ----
# Without PALLET_SMTP_HOST the daily run is a dry run: emails are prepared and shown in the log, not sent.
# PALLET_SMTP_HOST=smtp.office365.com
# PALLET_SMTP_PORT=587
# PALLET_SMTP_USER=assettrack@aisglass.com
# PALLET_SMTP_PASS=
# PALLET_SMTP_FROM=assettrack@aisglass.com
# PALLET_SMTP_TLS=1
# Local hour of the daily reminder run (default 9 = 09:00)
PALLET_REMINDER_HOUR=9

# ---- Oracle EBS / GCS integration ----
# STUB = pretend answers (pilot), LIVE = real calls, OFF = disabled
PALLET_INTEGRATION_MODE=STUB
# PALLET_EBS_AUTH=user:password
# PALLET_EBS_SO_URL=https://ebs.aisglass.com/api/so
# PALLET_EBS_CHALLAN_URL=
# PALLET_EBS_SUBINV_URL=
# PALLET_EBS_ONHAND_URL=
# PALLET_EBS_INVOICE_URL=
# PALLET_EBS_RETURN_CHALLAN_URL=
# PALLET_EBS_WMS_STOCK_URL=
